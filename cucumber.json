{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await",
      "resultsDir": "allure-results"
    },
    "paths": [
      "features/*.feature"
    ],
    "require": [
      "features/stepDefinition/*.ts",
      "features/support/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "summary",
  "allure-cucumberjs/reporter",
  "junit:results.xml"
    ]
  }
}